          "command": "uv run python - <<'PYLOCK'\nimport subprocess, tomllib\nfrom pathlib import Path\nbefore = tomllib.loads(subprocess.check_output(['git', 'show', '2ef5bb2794929da781f7a98ec40a337a0260ec60:uv.lock'], text=True))\nafter = tomllib.loads(Path('uv.lock').read_text())\ndef without_certifi(lock):\n    certifi = next(p for p in lock['package'] if p['name'] == 'certifi')\n    lock['package'].remove(certifi)\n    return certifi\nold, new = without_certifi(before), without_certifi(after)\nassert before == after, 'Non-certifi lock data changed'\nassert old != new\nassert tuple(map(int, new['version'].split('.'))) >= (2026, 10, 19)\nprint('Only certifi changed:', old['version'], '->', new['version'])\nPYLOCK",
